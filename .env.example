# Copy to your hosting dashboard / local environment; never commit real secrets.
OPENAI_API_KEY=
SECRET_KEY=replace-with-a-long-random-secret
OPENAI_MODEL=gpt-4.1
MONTHLY_BUDGET_USD=5
MAX_DAILY_REQUESTS=40
MAX_OUTPUT_TOKENS=2500
# Verify these against current official pricing for the selected model.
INPUT_PRICE_PER_1M=2.00
OUTPUT_PRICE_PER_1M=8.00
COOKIE_SECURE=0
# For a persistent hosting disk, set both to that disk's path:
# INSTANCE_DIR=/var/data
# DATABASE_PATH=/var/data/app.sqlite3
